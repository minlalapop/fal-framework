classDiagram
direction TB

class FAL {
  +config
  +run() Any
}

class FALConfig {
  <<Experiment_Configuration>>
  +data config
  +model config
  +training config
  +attack config
  +evaluation config
  +federated config
  +runtime config
  +validate() FALConfig
}

class CoreBuilder {
  <<Component_Builder>>
  +config
  +build() Experiment
  -_build_dataset_manager()
  -_build_model()
  -_build_attack()
  -_build_trainer(...)
  -_build_fl_system()
}

class Experiment {
  <<Pipeline>>
  +dataset_manager
  +model
  +trainer
  +metrics_manager
  +fl_system
  +attack
  +execute() Any
}

class FALResult {
  <<Output>>
  +latest_loss
  +latest_metrics
  +save_outputs(directory, save_model) dict
  +metric(name, round_number) Any
  +summary(include_details) str
  +print_summary(include_details) None
}

class FALProgressReporter {
  <<Progress_UI>>
  +start(num_rounds, num_clients, run_config) None
  +evaluate_end(round_number, loss, metrics) None
  +finish() None
}

FAL *-- FALConfig : config
FAL --> CoreBuilder : build
CoreBuilder --> Experiment : create
Experiment --> FALResult : return
Experiment ..> FALProgressReporter : progress

