classDiagram
direction TB

class BaseTrainer {
  <<abstract>>
  +model
  +attack
  +metrics_manager
  +loss_manager
  +trainer_params
  +train(data) Any
  +evaluate(data) EvaluationResult
}

class CleanTrainer {
  +train(data) Any
}

class AttackOnlyTrainer {
  +train(data) Any
  +evaluate(data) EvaluationResult
}

class AdversarialTrainer {
  +train(data) Any
  +evaluate(data) EvaluationResult
}

class MixedTrainer {
  +clean_trainer
  +attack_trainer
  +adversarial_trainer
  +train(data) Any
  +evaluate(data) EvaluationResult
}

class TrainerFactory {
  -_registry
  +register(name, trainer_cls)
  +create(trainer_type, model, attack, metrics_manager, loss_manager, trainer_params)
  -_normalize_name(value)
}

BaseTrainer <|-- CleanTrainer
BaseTrainer <|-- AttackOnlyTrainer
BaseTrainer <|-- AdversarialTrainer
BaseTrainer <|-- MixedTrainer
MixedTrainer *-- CleanTrainer : clean_trainer
MixedTrainer *-- AttackOnlyTrainer : attack_trainer
MixedTrainer *-- AdversarialTrainer : adversarial_trainer
TrainerFactory ..> BaseTrainer : creates
