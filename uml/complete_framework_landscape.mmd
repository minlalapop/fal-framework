flowchart LR
  %% Complete architecture view optimized for A4 landscape.
  %% This is an UML-style module/class overview, less dense than a full classDiagram.

  subgraph API["Public API"]
    FAL["FAL\n- config: FALConfig\n+ run(): FALResult"]
    CONFIG["FALConfig\n- dataset / model / trainer\n- attack / metrics / FL params\n+ validate()"]
    RESULT["FALResult\n- final model\n- losses / metrics\n- artifact_paths\n+ save_outputs()\n+ summary()"]
  end

  subgraph CORE["Core orchestration"]
    BUILDER["CoreBuilder\n+ build(): Experiment\n\ncreates all components"]
    EXP["Experiment\n+ execute(): FALResult\n\nruns dataset prep + FL"]
  end

  subgraph DATA["Dataset module"]
    DM["DatasetManager\n+ prepare()\n+ get_clients_data()\n+ get_test_data()"]
    DL["DatasetLoader\n<<interface>>\n+ load()"]
    LOADERS["Concrete loaders\nBuiltinDatasetLoader\nCustomCSVDatasetLoader\nArrayDatasetLoader"]
    SPLITTER["ClientSplitter\n<<interface>>\n+ split(X, y, num_clients)"]
    SPLITTERS["Concrete splitters\nIIDSplitter\nNonIIDSplitter"]
  end

  subgraph MODEL["Model module"]
    MF["ModelAdapterFactory\n+ register()\n+ create()"]
    BM["BaseModel\n<<interface>>\n+ fit()\n+ predict()\n+ get_raw_model()"]
    MADAPTERS["Model adapters\nSklearnModelAdapter\nPyTorchModelAdapter"]
  end

  subgraph ADV["Adversarial module"]
    AF["AttackFactory\n+ register()\n+ create()"]
    BA["BaseAttack\n<<interface>>\n+ generate()"]
    ATTACKS["Attacks\nFGSM\nPGD\nDeepFool"]
    BF["AttackBackendFactory\n+ create()"]
    BACKEND["AttackBackend\n<<interface>>\n+ generate()"]
    ART["ARTBackend\n+ build_estimator()\n+ generate()"]
    ARTADAPTERS["ART model adapters\nPyTorchARTAdapter\nSklearnARTAdapter"]
  end

  subgraph TRAIN["Training module"]
    TF["TrainerFactory\n+ register()\n+ create()"]
    BT["BaseTrainer\n<<abstract>>\n+ train()\n+ evaluate()"]
    TRAINERS["Concrete trainers\nCleanTrainer\nAttackOnlyTrainer\nAdversarialTrainer\nMixedTrainer"]
  end

  subgraph EVAL["Evaluation module"]
    METF["MetricFactory\n+ create()"]
    MM["MetricsManager\n+ compute_all()"]
    METRICS["Metrics\nAccuracy / F1\nPrecision / Recall\nConfusionMatrix\nClassificationReport"]
    LF["LossFactory\n+ create()"]
    LM["EvaluationLossManager\n+ compute()"]
    LOSSES["Losses\nLogLoss\nMSELoss\nModelLoss"]
    ER["EvaluationResult\n- loss\n- metrics"]
  end

  subgraph FL["Federated learning module"]
    FLS["FLSystem\n+ start()"]
    FBF["FLBackendFactory\n+ create()"]
    FLB["FLBackend\n<<interface>>\n+ start()"]
    FLOWER["FlowerBackend\n+ start()\n\norchestrates Flower"]
    STRF["StrategyFactory\n+ create()"]
    STR["StrategyAdapter\n<<interface>>\n+ build_strategy()"]
    STRATEGIES["Strategies\nFedAvg\nFedProx\nFedAdam"]
  end

  subgraph FLOWERDETAILS["Flower integration"]
    CFACT["FlowerClientFactory\n+ create_clients()"]
    CLIENT["FlowerClientAdapter\n+ get_parameters()\n+ fit()\n+ evaluate()"]
    SERVER["FlowerServerAdapter\n+ start_server()"]
    PARAM["FlowerParameterAdapter\n<<interface>>\n+ get_parameters()\n+ set_parameters()"]
    PARAMS["Parameter adapters\nPyTorchParameterAdapter\nSklearnParameterAdapter"]
  end

  subgraph OUT["Artifacts and display"]
    PROGRESS["FALProgressReporter\nround table + progress"]
    FILES["results/results_n\nmodel.pkl\nmetrics.csv\ndetailed_metrics.csv"]
  end

  FAL --> CONFIG
  FAL --> BUILDER
  BUILDER --> EXP
  EXP --> RESULT

