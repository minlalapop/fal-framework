flowchart TB
  API["Public API\nFAL.run()"]
  CONFIG["Configuration\nFALConfig"]
  BUILDER["Component Builder\nCoreBuilder"]

  subgraph DATA["Data Module"]
    LOADER["DatasetLoaders\nbuilt-in / CSV / arrays"]
    SPLITTER["ClientSplitters\nIID / Non-IID"]
    MANAGER["DatasetManager\ntrain-test split + client partitions"]
  end

  subgraph MODEL["Model Module"]
    MODELFACTORY["ModelAdapterFactory"]
    ADAPTERS["ModelAdapters\nPyTorch / sklearn"]
  end

  subgraph TRAINING["Training Module"]
    TRAINFACTORY["TrainerFactory"]
    TRAINERS["Trainers\nclean / attack_only / adversarial / mixed"]
  end

  subgraph ADV["Adversarial Module"]
    ATTACKFACTORY["AttackFactory"]
    ATTACKS["Attacks\nFGSM / PGD / DeepFool"]
    ART["ARTBackend\nART estimator adapters"]
  end

  subgraph EVAL["Evaluation Module"]
    METRICS["MetricsManager\naccuracy / f1 / reports"]
    LOSSES["EvaluationLossManager\nlog_loss / mse / model_loss"]
    EVALRESULT["EvaluationResult\nloss + metrics"]
  end

  subgraph FL["Federated Learning Module"]
    FLSYSTEM["FLSystem"]
    STRATEGY["StrategyAdapter\nFedAvg / FedProx / FedAdam"]
    FLOWER["FlowerBackend\nclients + server simulation"]
  end

  RESULT["FALResult\nhistory + metrics + artifacts"]

  API --> CONFIG
  CONFIG --> BUILDER

  BUILDER --> MANAGER
